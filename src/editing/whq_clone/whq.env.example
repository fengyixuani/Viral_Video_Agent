# =============================================================================
# whq 结构级复刻 — 配置模板 (全部为环境变量, 可 source 后运行)
#
#   set -a; source whq.env; set +a
#   python -m whq.run_clone --slug <slug> --ref <ref> --out <out.mp4> ...
#
# 每一项都给了内置默认值; 不设置=用默认(等价旧行为)。按需取消注释并修改。
# 布尔量: "1"=开, "0"=关。
# =============================================================================

# -------------------------- 运行环境(通常必设) --------------------------------
# whq 源根加入 PYTHONPATH, 以便 `python -m whq.run_clone`
export PYTHONPATH="/home/wanghequan/Viral_Video_Split/generation"
# 配音 TTS(CosyVoice3 零样本) 解释器 —— 必须是带 cosyvoice 的 env
export TTS_PYTHON="/root/miniconda3/envs/viral-split-tts/bin/python"
# ffmpeg(需含 libass 以烧录字幕)
export FFMPEG="/root/miniconda3/envs/viral-split-tts/bin/ffmpeg"
# 用户/参考视频 ASR(Qwen3-ASR) 解释器
export ASR_PYTHON="/root/miniconda3/envs/viral-split-asr/bin/python"
# 人脸检测(YuNet)子进程解释器(需 cv2); voice_policy 判"有人脸才保留原声"用
export WHQ_CV_PYTHON="/root/miniconda3/bin/python3.13"
# LLM 走 Wenchain-OpenAI 代理(ali-qwen3.7-plus 只在 Wenchain 暴露)
export USE_WENCHAIN_OPENAI="1"
# Qwen3-ASR 权重(一般用默认)
# export QWEN3_ASR_MODEL="/home/wanghequan/Viral_Video_Split/models/Qwen3-ASR-0.6B"
# export QWEN3_FORCED_ALIGNER="/home/wanghequan/Viral_Video_Split/models/Qwen3-ForcedAligner-0.6B"

# -------------------------- 原声优先 & 计划择优(edit_planner) -----------------
# 匹配阶段偏向"窗口内自带贴题口播"的素材, 让下游能保留用户真实原声(默认关)
export WHQ_PREFER_ORIGINAL_VOICE="1"
# 确定性打分里给"有可用口播"候选的加分(相关性满分约 1.0)
# export WHQ_ORIGINAL_VOICE_BONUS="0.25"
# best-of-K: 采样 K 个分配方案, 按"原声率"择优(连贯仅平局项); 1=单次(旧行为)
export WHQ_PLAN_BEST_OF_K="3"
# 对原声率最高的候选做"最弱衔接定向修复"(换桥接口播); 默认开
# export WHQ_PLAN_COHERENCE_REPAIR="1"
# 人工硬约束: 强制某槽用指定素材 global_asset_id(逗号分隔多段); 不被自动修复改动。
# 槽位为 reorder 后的最终 slot_id。素材 id 见 <out>_plan.json 的 best_candidate.global_asset_id
# export WHQ_SLOT_PIN="S02=2025-04-20 222615::A2,S03=2025-04-20 222615::A5"

# -------------------------- 原声/克隆决策(voice_policy) -----------------------
# 窗口内至少多少中文字才算"本就有口播"(滤掉"嗯/好"口水音)
# export WHQ_VOICE_MIN_CHARS="6"
# 说话时长占窗口比例阈值(太稀疏=零星词, 铺不满)
# export WHQ_VOICE_MIN_COVERAGE="0.45"
# 抽帧有人脸帧占比阈值(有人脸才保留原声, 保证口型对得上)
# export WHQ_FACE_MIN_RATIO="0.4"
# 原声允许的最慢/最快同倍率变速(音画同步, 超界则改克隆或截句)
# export WHQ_VOICE_MIN_ATEMPO="0.75"
# export WHQ_VOICE_MAX_ATEMPO="1.35"
# 相邻字间隔>=此秒数视为一个分句结束(句子级对窗用)
# export WHQ_SENT_GAP="0.35"
# 自定义 YuNet 人脸模型路径(默认 models/face_detection_yunet_2023mar.onnx)
# export WHQ_FACE_MODEL="/home/wanghequan/Viral_Video_Split/models/face_detection_yunet_2023mar.onnx"

# -------------------------- 配音 / TTS(voiceover, build_tts_overlay) ----------
# 无 ref_cps 时的全局默认语速(字/秒)及钳制区间
# export TTS_CHARS_PER_SECOND="3.8"
# export TTS_CPS_MIN="2.5"
# export TTS_CPS_MAX="6.0"
# 声音克隆参考音选取的时长窗口(秒)
# export TTS_PROMPT_MIN_SECONDS="8"
# export TTS_PROMPT_MAX_SECONDS="18"
# 配音叠加音量(默认 1.0; >1 易削波致"不清晰")
# export TTS_OVERLAY_VOLUME="1.0"
# 单段 TTS 压进槽位的最大 atempo 上限(源 TTS 偏慢时放宽)
# export TTS_MAX_ATEMPO="2.6"
# 超长文案先缩短再变速的轮数
# export TTS_RESYNTH_ROUNDS="2"
# 克隆段起点低频哼鸣修复的淡入时长 / 高频清晰度 EQ(置空关闭)
# export WHQ_TTS_ONSET_FADE="0.008"
# export WHQ_TTS_CLARITY_EQ="highshelf=f=2500:g=3"

# -------------------------- 语速贴参考(pace_match) ----------------------------
# 逐段加速的上/下限倍率, 及目标语速上限(字/秒)
# export WHQ_PACE_MAX_SPEED="1.4"
# export WHQ_PACE_MIN_SPEED="1.0"
# export WHQ_PACE_TARGET_CPS="5.5"
