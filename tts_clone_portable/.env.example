# Text LLM used only to choose among the top 8 ASR candidates.
WENCHAIN_BASE_URL=http://your-gateway.example/v1
WENCHAIN_API_KEY=replace-me
TEXT_LLM_MODEL=ali-qwen3.7-max
LLM_TIMEOUT=300

# Compatible TTS backend command. VoxCPM2 example:
AGENT_TTS_PYTHON=/path/to/conda/envs/voxcpm/bin/python
AGENT_TTS_SCRIPT=/path/to/run_voxcpm2_zero_shot.py
AGENT_TTS_TIMEOUT=600
AGENT_TTS_PROMPT_MODE=basic
AGENT_TTS_LUFS=-16

# VoxCPM2 backend options (read by the backend script).
VOXCPM_MODEL_ID=openbmb/VoxCPM2
WHQ_VOXCPM_CFG=2.0
WHQ_VOXCPM_STEPS=30
WHQ_VOXCPM_NORMALIZE=1
# HF_ENDPOINT=https://hf-mirror.com
# WHQ_VOXCPM_OUTPUT_SR=48000
