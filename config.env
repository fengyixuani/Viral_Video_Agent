# =============================================================================
# Viral Video Agent —— 一站式配置文件（改这一份就够）
# =============================================================================
# 拿到项目后，只改这个文件即可完成本地化配置。规则：
#   1) 所有键都是**可选**的——代码里都有内建默认，缺失也能跑主链路。
#   2) 想覆盖哪一项就把它前面的 `#` 去掉、改为自己的值。
#   3) 已经 `export` 的环境变量**优先**于本文件（本文件走 setdefault）。
#   4) 支持 ${VAR} 引用同文件里前面已定义的键、或已 export 的环境变量。
#   5) 加载时机：`server/_paths.py` 在 `sys.path` 设置阶段读取本文件，
#      因此后续所有 `os.getenv(...)` 都能拿到这里的值。
#
# 模型清单与用途见 MODELS.md；ASR/TTS 子环境安装步骤见 README §6.3。
# =============================================================================

# --------------- 服务端口 / 主机 ---------------
# PORT=8000
# HOST=0.0.0.0

# --------------- wenchain 网关（默认已配好，仅在换网关/换 channel 时改） ---------------
# WENCHAIN_BASE_URL=http://wenku-openai.baidu-int.com/wenchain/strategy
# WENCHAIN_API_KEY=wangpantob_all_video_copy

# --------------- 主模型选择（走网关，不用本地）---------------
# VISION_LLM_MODEL=ali-qwen3.7-plus
# TEXT_LLM_MODEL=ali-qwen3.7-max
# EMBED_MODEL=qwen3-embedding-0.6b

# --------------- AIGC 补镜（seedream 首帧 + seedance 视频，走网关）---------------
# AIGC_T2I_MODEL=doubao-seedream-5-0-260128
# AIGC_I2V_MODEL=doubao-seedance-2-0
# AIGC_ASPECT=9:16
# AIGC_T2I_SIZE=1664x2368
# AIGC_MAX_SUBAGENTS=5

# --------------- 审片（Gemini via oneapi-comate）---------------
# GEMINI_REVIEW_MODEL=gemini-2.5-pro
# ONEAPI_BASE_URL=
# ONEAPI_TOKEN=

# =============================================================================
# 可选：本地 ASR / TTS 子环境（详见 README §6.3 + MODELS.md）
# 想启用「口播识别」和「声音克隆」时，取消下面几行的注释并改为你机器上的路径。
# 不配也能跑主链路——tts_clone 工具会返回"未配置"、审片自动改为只看画面。
# =============================================================================

# ---- Split 兄弟仓库根目录（放 ASR/TTS 脚本 + models/）----
# VIRAL_VIDEO_SPLIT_ROOT=/absolute/path/to/Viral_Video_Split

# ---- ASR 子环境（Qwen3-ASR-0.6B + Qwen3-ForcedAligner-0.6B）----
# ASR_PYTHON=/absolute/path/to/miniconda/envs/qwen3-asr-cu128/bin/python
# ASR_SCRIPT=${VIRAL_VIDEO_SPLIT_ROOT}/common/vendor/Viral_Video/run_qwen3_asr_test.py
# QWEN3_ASR_MODEL=${VIRAL_VIDEO_SPLIT_ROOT}/models/Qwen3-ASR-0.6B
# QWEN3_FORCED_ALIGNER=${VIRAL_VIDEO_SPLIT_ROOT}/models/Qwen3-ForcedAligner-0.6B

# ---- TTS 子环境（CosyVoice3 zero-shot 声音克隆）----
# TTS_PYTHON=/absolute/path/to/miniconda/envs/cosyvoice/bin/python
# TTS_SCRIPT=${VIRAL_VIDEO_SPLIT_ROOT}/generation/run_cosyvoice3_zero_shot.py
# TTS_MODEL_DIR=${VIRAL_VIDEO_SPLIT_ROOT}/models/CosyVoice-300M
# TTS_REPO=/absolute/path/to/CosyVoice

# --------------- 调试 / MOCK ---------------
# ALLOW_MOCK_LLM=0        # 1 = 网络不可达时走本地 mock 数据（仅调试）
# LOG_LEVEL=INFO

