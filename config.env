# =============================================================================
# Viral Video Agent —— 一站式配置文件（改这一份就够）
# =============================================================================
# 拿到项目后，只改这个文件即可完成本地化配置。规则：
#   1) 所有键都是**可选**的——代码里都有内建默认，缺失也能跑主链路。
#   2) 想覆盖哪一项就把它前面的 `#` 去掉、改为自己的值。
#   3) 已经 `export` 的环境变量**优先**于本文件（本文件走 setdefault）。
#   4) 支持 ${VAR} 引用同文件里前面已定义的键、或已 export 的环境变量。
#   5) 加载时机：`server/_paths.py` 在 `sys.path` 设置阶段读取本文件，
#      因此后续所有 `os.getenv(...)` 都能拿到这里的值。
#
# 模型清单与用途见 MODELS.md；ASR/TTS 子环境安装步骤见 README §6.3。
# =============================================================================

# --------------- 服务端口 / 主机 ---------------
# PORT=8000
# HOST=0.0.0.0

# --------------- wenchain 网关（默认已配好，仅在换网关/换 channel 时改） ---------------
# WENCHAIN_BASE_URL=http://wenku-openai.baidu-int.com/wenchain/strategy
# WENCHAIN_API_KEY=wangpantob_all_video_copy

# --------------- 主模型选择（走网关，不用本地）---------------
# VISION_LLM_MODEL=ali-qwen3.7-plus
# TEXT_LLM_MODEL=ali-qwen3.7-max
# EMBED_MODEL=qwen3-embedding-0.6b

# --------------- AIGC 补镜（seedream 首帧 + seedance 视频，走网关）---------------
# AIGC_T2I_MODEL=doubao-seedream-5-0-260128
# AIGC_I2V_MODEL=doubao-seedance-2-0
# AIGC_ASPECT=9:16
# AIGC_T2I_SIZE=1664x2368
# AIGC_MAX_SUBAGENTS=5

# --------------- 审片（Gemini via oneapi-comate）---------------
# GEMINI_REVIEW_MODEL=gemini-2.5-pro
# ONEAPI_BASE_URL=
# ONEAPI_TOKEN=

# =============================================================================
# 可选：本地 ASR / TTS 子环境（详见 README §6.3 + MODELS.md）
# 想启用「口播识别」和「声音克隆」时，取消下面几行的注释并改为你机器上的路径。
# 不配也能跑主链路——tts_clone 工具会返回"未配置"、审片自动改为只看画面。
# =============================================================================

# ---- Split 兄弟仓库根目录（放 ASR/TTS 脚本 + models/）----
# VIRAL_VIDEO_SPLIT_ROOT=/absolute/path/to/Viral_Video_Split

# ---- ASR 子环境（Qwen3-ASR-0.6B + Qwen3-ForcedAligner-0.6B）----
# ASR_PYTHON=/absolute/path/to/miniconda/envs/qwen3-asr-cu128/bin/python
# ASR_SCRIPT=${VIRAL_VIDEO_SPLIT_ROOT}/common/vendor/Viral_Video/run_qwen3_asr_test.py
# QWEN3_ASR_MODEL=${VIRAL_VIDEO_SPLIT_ROOT}/models/Qwen3-ASR-0.6B
# QWEN3_FORCED_ALIGNER=${VIRAL_VIDEO_SPLIT_ROOT}/models/Qwen3-ForcedAligner-0.6B

# ---- TTS 子环境（zero-shot 声音克隆）----
# Agent 剪辑的 tts_clone 走 src/editing/tts.py，按 CosyVoice 的 CLI 契约调子进程：
#   --prompt-wav 参考音频 / --prompt-asr 参考转写 / --text 目标文案 / --output wav
# 用 AGENT_TTS_* 单独指定 Agent 链路的模型（不写则回退 TTS_PYTHON/TTS_SCRIPT）——whq 的
# legacy workflow 也在用 TTS_PYTHON 跑它自己的包装器，共用一组变量会把两条链路一起换掉。
#
# 当前 Agent 剪辑：VoxCPM2（whq 里那个脚本刻意做成 CosyVoice CLI 兼容，参数一致）。
# 回退成 CosyVoice3：把下面两行注释掉并重启服务。
AGENT_TTS_PYTHON=/root/miniconda3/envs/voxcpm/bin/python
AGENT_TTS_SCRIPT=/home/wanghequan/Viral_Video_Agent/src/editing/whq_clone/run_voxcpm2_zero_shot.py
# VoxCPM2 可调项：CFG 越大越贴参考音色（但可能不稳）；STEPS 越大越精细越慢
HF_ENDPOINT=https://hf-mirror.com
# VOXCPM_MODEL_ID=openbmb/VoxCPM2
# WHQ_VOXCPM_CFG=2.0
# WHQ_VOXCPM_STEPS=30
#
# CosyVoice3（Split 仓，默认回退目标）：
# TTS_PYTHON=/absolute/path/to/miniconda/envs/cosyvoice/bin/python
# TTS_SCRIPT=${VIRAL_VIDEO_SPLIT_ROOT}/generation/run_cosyvoice3_zero_shot.py
# TTS_MODEL_DIR=${VIRAL_VIDEO_SPLIT_ROOT}/models/CosyVoice-300M
# TTS_REPO=/absolute/path/to/CosyVoice

# --------------- 调试 / MOCK ---------------
# ALLOW_MOCK_LLM=0        # 1 = 网络不可达时走本地 mock 数据（仅调试）
# LOG_LEVEL=INFO

# =============================================================================
# reproduce_mode=whq_clone：结构级复刻（src/editing/whq_clone）
# 一步出成片（硬剪+配音+字幕+语速贴参考）。LLM 走 as_core 同一 wenchain 网关；
# 但配音(build_tts_overlay)/ASR(batch_qwen3_asr)/人脸(YuNet) 仍以子进程调 Split
# 兄弟仓的脚本 + 模型权重，故需指向 Split 根与各专用 conda env。
# 缺失时优雅降级：无 ASR→全克隆+默认语速；无 TTS→保留无声 base；无人脸→按口播判定。
# =============================================================================
VIRAL_VIDEO_SPLIT_ROOT=/home/wanghequan/Viral_Video_Split
# 配音 TTS（CosyVoice3 零样本）解释器 —— 必须带 cosyvoice 的 env
TTS_PYTHON=/root/miniconda3/envs/viral-split-tts/bin/python
# ffmpeg 需含 libass（whq 用 libass 烧字幕）
FFMPEG=/root/miniconda3/envs/viral-split-tts/bin/ffmpeg
# 用户/参考视频词级 ASR（Qwen3-ASR）解释器
ASR_PYTHON=/root/miniconda3/envs/viral-split-asr/bin/python
# 人脸检测（YuNet）子进程解释器（需 cv2）；voice_policy「有人脸才保留原声」用
WHQ_CV_PYTHON=/root/miniconda3/bin/python3.13
# Qwen3-ASR 权重（默认在 ${VIRAL_VIDEO_SPLIT_ROOT}/models 下，一般无需改）
# QWEN3_ASR_MODEL=${VIRAL_VIDEO_SPLIT_ROOT}/models/Qwen3-ASR-0.6B
# QWEN3_FORCED_ALIGNER=${VIRAL_VIDEO_SPLIT_ROOT}/models/Qwen3-ForcedAligner-0.6B
# 原声优先匹配（尽量保留用户真实原声）+ best-of-K 择优（原声率主目标）
WHQ_PREFER_ORIGINAL_VOICE=1
WHQ_PLAN_BEST_OF_K=3
# 迁移后新增的几条约束会互相压制、成片不如迁移前；WHQ_LEGACY=1 一键回到迁移前行为，
# 等价于下面 4 个开关全关（用于 A/B 定位；确认某一条是元凶后改回单项控制）。
# WHQ_LEGACY=0
# 商品展示下限：至少几段无口播的商品 B-roll（0=关）；penalty 是每缺 1 段的扣分，
# 默认 1.0 >= 原声率上限，等于硬闸；调到 0.15 量级可退化为软偏好。
# WHQ_MIN_PRODUCT_SHOTS=2
# WHQ_PRODUCT_SHOT_PENALTY=1.0
# 原声完整句护栏：窗口末端不在自然停顿处就把该段原声降级为克隆（会显著降低原声率）
# WHQ_ORIGINAL_SENT_GUARD=1
# 文案硬约束（锚定本段素材 / 卖点不重复 / 催单只在末段）与目标字数放宽量
# WHQ_STRICT_SCRIPT=1
# WHQ_TARGET_CHARS_SLACK=4
# 结尾段用「LLM 从用户原声里选一句购买号召」；0 = 编排确定性排结尾段 + 克隆配音
# WHQ_CTA_ORIGINAL=1
# 阶段续跑：编排(plan)/硬剪(base)/配音(voice) 按输入指纹缓存，输入或相关开关变了自动重跑；
# 0 = 每次全量重跑（对比实验时用）
# WHQ_RESUME=1
# best-of-K 分配、连贯修复试换、画面仲裁的并发度（都是网络等待型的 LLM/VLM 调用）
# WHQ_LLM_CONCURRENCY=3
# 语速贴参考：默认只提「口播语速」、画面段长不变，成片总时长 = 参考总时长；
# 原声段锁 1.0x（口型要对得上）。=0 回到音画同倍率加速（总时长会明显短于参考）。
# WHQ_PACE_KEEP_TOTAL=1

